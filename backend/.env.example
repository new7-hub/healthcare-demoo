# Backend environment variables
PORT=5000

# Replace USERNAME, URL_ENCODED_PASSWORD, and the database/cluster values
# with the connection string copied from MongoDB Atlas > Connect > Drivers.
# Do not use a password that has been exposed in chat; rotate it in Atlas first.
MONGO_URL=mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/healthcare?retryWrites=true&w=majority

# Generate a secret with: openssl rand -hex 32. Copy it into your private backend/.env. Never commit or share it.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Local development origin. For a deployed frontend, change this to its exact https:// URL.
CLIENT_SITE_URL=http://localhost:5173

# Required only if the app uses Stripe checkout; use your Stripe test secret locally.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_TEST_SECRET
